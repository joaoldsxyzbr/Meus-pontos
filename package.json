{
  "name": "meus-pontos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run test:workers",
    "test:workers": "vitest run --config vitest.config.ts",
    "check:frontend": "svelte-check --tsconfig frontend/tsconfig.json",
    "build:frontend": "vite build --config vite.frontend.config.ts",
    "build:staging": "node scripts/build-staging.mjs",
    "test:staging": "node --test scripts/staging.test.mjs",
    "build:release": "node scripts/build-release.mjs",
    "test:release": "node --test scripts/release.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20261102.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "svelte": "^5.46.4",
    "zod": "^4.0.0"
  }
}
