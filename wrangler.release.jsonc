{
  "name": "meus-pontos",
  "main": "src/release-worker.js",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist/release",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meus-pontos",
      "database_id": "150895af-1ec9-4c6c-af03-a43189a9bb71"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "520261020",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ],
  "$schema": "./node_modules/wrangler/config-schema.json"
}
